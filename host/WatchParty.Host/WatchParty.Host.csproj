<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WatchParty.Host</RootNamespace>
    <AssemblyName>WatchParty.Host</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's engine: the one source of the request filter, fullscreen,
         permission and script hooks ADR-034 depends on (ADR-035). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- M7 (ADR-042): the one zip `npm run portable` embeds as the payload. A
       developer build passes no WatchPartyPayload, so nothing is embedded and
       `dotnet build host/WatchParty.Host` is unchanged. -->
  <ItemGroup Condition="'$(WatchPartyPayload)' != ''">
    <EmbeddedResource Include="$(WatchPartyPayload)" LogicalName="WatchParty.Payload.zip" />
  </ItemGroup>

</Project>
